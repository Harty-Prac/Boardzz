<Window x:Class="boardzz.ui.settingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#232428" Foreground="#F2F3F5" FontFamily="Segoe UI">

    <DockPanel Margin="24,18,24,24">
        <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="22" FontWeight="Bold"/>

        <Grid DockPanel.Dock="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Content="Never mind" Style="{StaticResource flatButton}" IsCancel="True"/>
            <Button Grid.Column="2" Content="Save" Style="{StaticResource accentButton}" IsDefault="True"
                    Click="onSaveClick"/>
        </Grid>

        <StackPanel x:Name="settingsPanel" Margin="0,16,0,16">
            <TextBlock Text="Playback" Style="{StaticResource fieldLabel}"/>
            <CheckBox x:Name="overlapBox" Foreground="{StaticResource textBrush}" Cursor="Hand" Margin="-8,4,0,0">
                <StackPanel>
                    <TextBlock Text="Let pads play over each other" FontSize="14"/>
                    <TextBlock Text="When off, pressing a pad stops the one that's playing."
                               Opacity="0.6" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </CheckBox>

            <TextBlock Text="Recording" Style="{StaticResource fieldLabel}" Margin="0,22,0,0"/>
            <CheckBox x:Name="recordBox" Foreground="{StaticResource textBrush}" Cursor="Hand" Margin="-8,4,0,0">
                <StackPanel>
                    <TextBlock Text="Keep a rolling recording" FontSize="14"/>
                    <TextBlock Text="Lets Save clip grab the last few seconds from your sources. Off frees the memory."
                               Opacity="0.6" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </CheckBox>
            <StackPanel Orientation="Horizontal" Margin="28,10,0,0"
                        IsEnabled="{Binding IsChecked, ElementName=recordBox}">
                <TextBlock Text="Keep the last" VerticalAlignment="Center"/>
                <TextBox x:Name="secondsBox" Style="{StaticResource darkTextBox}" Width="64" Padding="4,5"
                         Margin="8,0" TextAlignment="Center" MaxLength="3"/>
                <TextBlock x:Name="secondsHint" VerticalAlignment="Center" Opacity="0.6"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
