<UserControl x:Class="boardzz.ui.emojiPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Button x:Name="fieldButton" Click="onFieldClick" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="chrome" Background="#1E1F22" BorderBrush="#3A3D44" BorderThickness="1"
                            CornerRadius="8" Padding="10,0" Height="40">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chrome" Property="BorderBrush" Value="#5865F2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
                <Image x:Name="selectedImage" Width="24" Height="24" Visibility="Collapsed"/>
                <TextBlock x:Name="fieldText" Text="Click to select" Foreground="#9AA0AA" FontSize="14"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Popup x:Name="popup" PlacementTarget="{Binding ElementName=fieldButton}" Placement="Bottom"
               VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#2B2D31" BorderBrush="#1E1F22" BorderThickness="1" CornerRadius="10" Padding="8">
                <StackPanel>
                    <WrapPanel x:Name="grid" Width="320"/>
                    <Button Content="No emoji" Style="{StaticResource flatButton}" FontSize="13" Padding="12,6"
                            Margin="0,8,0,0" HorizontalAlignment="Left" Click="onClearClick"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
