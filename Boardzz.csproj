<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>boardzz</RootNamespace>
    <AssemblyName>Boardzz</AssemblyName>
    <Product>Boardzz</Product>
    <ApplicationIcon>Assets\boardzz.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\boardzz.ico" />
  </ItemGroup>

  <!-- Bundled VB-CABLE driver pack (vb-cable.com, donationware), copied next to Boardzz.exe -->
  <ItemGroup>
    <Content Include="vendor\VBCABLE\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
  </ItemGroup>

</Project>
